					<Parameter>
						<Name><![CDATA[profit]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[try{
String filePath = ".\\data.csv";
java.io.Writer output;
output = new java.io.BufferedWriter(new java.io.FileWriter(filePath, true));
output.append(t + "," + sc_n + "," + profit + "\n");
output.close();
}
catch (java.io.IOException ex)
{System.out.println(ex.getMessage());}]]></Body>
